# Copy these placeholders into your local .env.local for development.
# In Vercel, configure the actual values under Project Settings -> Environment Variables.
# Never commit real credentials. Rotate any keys that were previously committed.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY"

# Admin authentication
ADMIN_JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
ADMIN_USERNAME="saqib"
ADMIN_PBKDF2_SALT="REPLACE_WITH_RANDOM_HEX_SALT"
ADMIN_PBKDF2_HASH="REPLACE_WITH_PASSWORD_HASH"
ADMIN_PBKDF2_ITERATIONS="100000"

# ImageKit (optional; use values from your own project)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="YOUR_IMAGEKIT_PUBLIC_KEY"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/YOUR_IMAGEKIT_ID"
IMAGEKIT_PRIVATE_KEY="YOUR_IMAGEKIT_PRIVATE_KEY"

# Application / domain configuration
APP_URL="https://your-app.vercel.app"
GEMINI_API_KEY=""
ALLOWED_DOMAINS="yourcustomdomain.com"
DISABLE_KILLSWITCH="false"
