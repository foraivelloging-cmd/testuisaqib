# ==============================================================================
# SAQIB VISUALS HUB - PRODUCTION ENVIRONMENT CONFIGURATION
# 1-CLICK CLIENT RESELL & CLONE TEMPLATE iiii.
# ==============================================================================
# Jab aap new client ko ye website sell/deploy karein:
# 1. New Supabase project banayein aur uske SQL Editor mein 'master_query.sql' run karein.
# 2. Vercel dashboard mein jaa kar ye Environment Variables set karein...
# 3. Code automatically new client ke database se connect ho jayega!
# ==============================================================================

# ==================== 1. SUPABASE DATABASE CONFIG ====================
# Project Settings -> API se copy karein:
# (Dono names support karta hai: NEXT_PUBLIC_SUPABASE_URL ya SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL="https://ratihfmqpiqervqpkaml.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_MDzFyMLQ-tUHJHZQ8TWx_w_yNO9QZFn"

# Project Settings -> API -> Project API Keys -> 'service_role' secret:
# (Dono names support karta hai: SUPABASE_SERVICE_ROLE_KEY ya SERVICE_ROLE_KEY)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJhdGloZm1xcGlxZXJ2cXBrYW1sIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MjM5OTI5NywiZXhwIjoyMTA3OTc1Mjk3fQ.XoGA9RKbxvNMkOoysds6d7gz9SDR7cz5m920mdqOrVk"

# ==================== 2. IMAGEKIT CDN CONFIG ====================
# ImageKit Dashboard -> Developer Options se copy karein (Auto image CDN uploads ke liye):
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_hAsIn5Rl4yEptvRhS++GoJeO9ck="
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/ws9mlpwdsj"
