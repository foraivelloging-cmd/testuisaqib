# ==============================================================================
# SAQIB VISUALS HUB - PRODUCTION ENVIRONMENT CONFIGURATION
# 1-CLICK CLIENT RESELL & CLONE TEMPLATE
# ==============================================================================
# Instructions for setup:
# 1. Copy this file and rename it to: .env.local
# 2. Create a new project on Supabase (https://supabase.com/dashboard)
# 3. In your Supabase SQL Editor, run 'master_query.sql'
# 4. Copy your project credentials from Supabase (Settings -> API) and paste below:
# ==============================================================================

# ==================== 1. SUPABASE DATABASE CONFIG ====================
# Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_NEW_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Project Settings -> API -> Project API Keys -> 'service_role' secret:
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key_here"

# ==================== 2. IMAGEKIT CDN CONFIG (Optional) ====================
# For image & payment proof uploads via CDN:
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_hAsIn5Rl4yEptvRhS++GoJeO9ck="
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/ws9mlpwdsj"
IMAGEKIT_PRIVATE_KEY="private_XiedF7mU8mxbGCLOnLcvgyTByE8="

# ==================== 3. APPLICATION URL & AI ====================
APP_URL="http://localhost:3000"
GEMINI_API_KEY=""

# ==================== 4. ADMIN SECURITY VAULT ====================
ADMIN_JWT_SECRET="super_secure_random_jwt_secret_token_here_2026"
ADMIN_USERNAME="saqib"

# ==================== 5. CLIENT CLONE & DOMAIN PERMISSIONS ====================
# Vercel (*.vercel.app) and localhost are automatically allowed.
# For custom client domains (e.g. clientagency.com), add here or set DISABLE_KILLSWITCH="true":
ALLOWED_DOMAINS="clientdomain.com,myagency.com"
DISABLE_KILLSWITCH="false"
