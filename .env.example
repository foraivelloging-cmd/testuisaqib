# ==================== 3. APPLICATION URL & AI ====================
APP_URL="https://your-client-app.vercel.app"
GEMINI_API_KEY=""

# ==================== 4. ADMIN SECURITY VAULT ====================
# Admin credentials (default saqib / saqibadmin already master_query.sql mein hain)
ADMIN_JWT_SECRET="super_secure_random_jwt_secret_token_here_2026"
ADMIN_USERNAME="saqib"

# ==================== 5. CLIENT CLONE & DOMAIN PERMISSIONS ====================
# Vercel (*.vercel.app) aur localhost already automatic allowed hain.
# Agar client ka custom domain ho (e.g. clientagency.com), yahan add karein ya DISABLE_KILLSWITCH="true" karein:
ALLOWED_DOMAINS="clientdomain.com,myagency.com"
DISABLE_KILLSWITCH="false"
